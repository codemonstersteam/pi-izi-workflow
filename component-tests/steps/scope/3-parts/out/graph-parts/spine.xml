<part cell="spine" kind="spine">
  <artifact name="eddi" root="."/>

  <suite id="unit" kind="unit" cmd="./mvnw test" one="-Dtest={{class}}" path="src/test/java" match="*Test.java"/>
  <suite id="component" kind="component" cmd="./mvnw verify" one="-Dit.test={{class}}" path="src/test/java" match="*IT.java"/>

  <build cmd="./mvnw clean verify" compile="./mvnw clean package -DskipTests"/>

  <toggles mechanism="MicroProfile Config properties (application.properties + env vars)" config="quarkus.oidc.tenant-enabled, eddi.openai-compat.enabled, eddi.hitl.tool.enabled, eddi.security.ssrf-protection.enabled, eddi.messaging.type, eddi.datastore.type"/>

  <branching branches="feat/&lt;name&gt; from main" commits="type(scope): description (Conventional Commits)"/>

  <contract found="no"/>

  <integration kind="db" system="mongodb" config="mongodb.connectionString" value="mongodb://mongodb:27017/eddi?retryWrites=true&amp;w=majority"/>
  <integration kind="db" system="postgresql" config="quarkus.datasource.jdbc.url" value="jdbc:postgresql://localhost:5432/eddi"/>
  <integration kind="queue" system="nats" config="eddi.nats.url" value="nats://localhost:4222"/>
  <integration kind="http" system="keycloak" config="quarkus.oidc.auth-server-url" value="http://localhost:8180/realms/eddi"/>
  <integration kind="http" system="opentelemetry" config="quarkus.otel.exporter.otlp.endpoint" value="http://localhost:4317"/>
</part>
